# Normalisasi line ending: repo pakai LF, Windows checkout tetap aman
* text=auto eol=lf

# RTL & constraint: LF wajib (Vivado tidak suka CRLF campur)
*.vhd   text eol=lf
*.vhdl  text eol=lf
*.xdc   text eol=lf
*.tcl   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# Biner
*.bit   binary
*.png   binary
*.jpg   binary
*.pdf   binary
